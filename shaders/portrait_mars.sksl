// The mars gate portrait: domain-warped value noise rising through a vertical column,
// a hot core falling away to embers at the edges. It reads as fire and marble without
// depicting either. Written in the dialect Skia runtime effects and AGSL share.
//
// This file also defines the shared portrait uniform block: every gate portrait declares
// exactly these uniforms, in exactly this order, so the host fills one FloatArray for any
// of them. Every uniform is a plain float for the same packing reason as crt.sksl.
//
// The quality tier arrives as `octaves`; zero octaves must still compose a readable still
// (that is the reduced-motion and Minimal-tier frame, with timeSeconds frozen by the host).

uniform float widthPixels;
uniform float heightPixels;
uniform float timeSeconds;
uniform float accentDimR;
uniform float accentDimG;
uniform float accentDimB;
uniform float accentBaseR;
uniform float accentBaseG;
uniform float accentBaseB;
uniform float accentHotR;
uniform float accentHotG;
uniform float accentHotB;
uniform float focusAmount;
uniform float audioLevel;
uniform float octaves;

const float MAX_OCTAVES = 6.0;
const float DRIFT = 0.055;
const float WARP_STRENGTH = 1.7;
const float COLUMN_POWER = 1.6;

float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float valueNoise(float2 p) {
    float2 cell = floor(p);
    float2 inside = fract(p);
    float2 eased = inside * inside * (3.0 - 2.0 * inside);
    float a = hash(cell);
    float b = hash(cell + float2(1.0, 0.0));
    float c = hash(cell + float2(0.0, 1.0));
    float d = hash(cell + float2(1.0, 1.0));
    return mix(mix(a, b, eased.x), mix(c, d, eased.x), eased.y);
}

float fbm(float2 p) {
    float sum = 0.0;
    float amplitude = 0.5;
    float weight = 0.0;
    for (float octave = 0.0; octave < MAX_OCTAVES; octave += 1.0) {
        if (octave >= octaves) { break; }
        sum += amplitude * valueNoise(p);
        weight += amplitude;
        amplitude *= 0.5;
        p = p * 2.03 + float2(17.0, 9.0);
    }
    return weight > 0.0 ? sum / weight : 0.5;
}

half4 main(float2 coord) {
    float2 uv = coord / float2(widthPixels, heightPixels);
    float centred = uv.x * 2.0 - 1.0;
    float column = pow(max(1.0 - abs(centred), 0.0), COLUMN_POWER);

    // Upward advection: the field scrolls down in sample space, so the flame rises.
    float2 field = float2(uv.x * 3.0, uv.y * 4.0 + timeSeconds * DRIFT);
    float2 warp = float2(
        fbm(field + float2(0.0, 0.0)),
        fbm(field + float2(5.2, 1.3)));
    float flame = fbm(field + WARP_STRENGTH * (warp - 0.5));

    // The core burns where the column is tall and the flame field agrees; audio and focus
    // both feed it, so the portrait leans toward the player.
    float heat = column * (0.35 + 0.65 * flame);
    heat *= 0.75 + 0.35 * focusAmount + 0.4 * audioLevel;
    float embers = column * (1.0 - uv.y) * 0.25;
    heat = clamp(heat + embers, 0.0, 1.0);

    half3 dim = half3(half(accentDimR), half(accentDimG), half(accentDimB));
    half3 base = half3(half(accentBaseR), half(accentBaseG), half(accentBaseB));
    half3 hot = half3(half(accentHotR), half(accentHotG), half(accentHotB));

    half3 colour = mix(dim * half(0.35), base, half(smoothstep(0.15, 0.75, heat)));
    colour = mix(colour, hot, half(smoothstep(0.65, 0.98, heat)));

    // The vignette keeps the column reading as a portal rather than a texture fill.
    float frame = smoothstep(0.0, 0.12, uv.y) * smoothstep(1.0, 0.88, uv.y);
    return half4(colour * half(frame), 1.0);
}
