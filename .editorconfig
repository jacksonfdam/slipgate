root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
ktlint_standard_property-naming = disabled

# Generated sources are written by build tasks — the Compose resource accessors and the embedded
# shader constants — and holding them to the project's style would mean patching the generators.
[**/build/generated/**]
ktlint = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
